{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the desktop window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/python-backend",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    "dialog:default"
  ]
}
