{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "荣科血透实施工具",
  "version": "0.2.0",
  "identifier": "com.example.desktopstarter",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd frontend && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HDMS 荣科血透实施工具",
        "width": 1040,
        "height": 860,
        "minWidth": 860,
        "minHeight": 640,
        "maximized": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "启动中",
        "url": "splashscreen.html",
        "width": 800,
        "height": 450,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:18765; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/python-backend"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
